{
  "name": "@local/dsh-agent-usage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "description": "Local AI coding-agent token usage dashboard: scans Claude Code, Codex, Cursor, OpenCode, Trae, Qoder, Devin, Pi, DeepSeek Harness and more from local files, and aggregates usage by agent, model and date.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host/*.js",
    "host/providers/*.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "CONTRACT.md",
    "README.md",
    "host/tools/*.mjs",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
