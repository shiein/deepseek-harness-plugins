{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "root": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![\\\\/]|[A-Za-z]:)"
          },
          "runtime": {
            "type": "object",
            "properties": {
              "strategy": {
                "type": "string",
                "enum": [
                  "static",
                  "isolated",
                  "project",
                  "attach"
                ]
              },
              "adapter": {
                "type": "string",
                "enum": [
                  "static",
                  "project-command",
                  "existing-server",
                  "vue-vite",
                  "vue-cli",
                  "react-vite"
                ]
              },
              "requirements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "isolated-target",
                    "mock-only"
                  ]
                }
              },
              "setup": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![\\\\/]|[A-Za-z]:)"
              },
              "styles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?![\\\\/]|[A-Za-z]:)"
                }
              },
              "entry": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![\\\\/]|[A-Za-z]:)"
              },
              "publicRoot": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![\\\\/]|[A-Za-z]:)"
              },
              "spaFallback": {
                "type": "boolean"
              },
              "command": {
                "type": "object",
                "properties": {
                  "executable": {
                    "type": "string",
                    "minLength": 1
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "cwd": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?![\\\\/]|[A-Za-z]:)"
                  }
                },
                "required": [
                  "executable",
                  "args",
                  "cwd"
                ],
                "additionalProperties": false
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "origin": {
                "type": "string",
                "pattern": "^https?:\\/\\/(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?$"
              },
              "readiness": {
                "type": "object",
                "properties": {
                  "probePath": {
                    "type": "string",
                    "pattern": "^\\/(?!\\/)"
                  },
                  "serviceDeadlineMs": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "targetDeadlineMs": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false
              },
              "dependencyRoots": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "selector": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "file"
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^(?![\\\\/]|[A-Za-z]:)"
                        },
                        "exportName": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "path"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "route"
                        },
                        "path": {
                          "type": "string"
                        },
                        "params": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "type": "string"
                          }
                        },
                        "query": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "type": "string"
                          }
                        },
                        "layout": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "kind",
                        "path"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "story"
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "id"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "url"
                        },
                        "url": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "url"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "page",
                    "component",
                    "shell"
                  ]
                },
                "route": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "params": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "query": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "path"
                  ],
                  "additionalProperties": false
                },
                "defaultScenario": {
                  "type": "string"
                },
                "assertions": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "selector-visible"
                          },
                          "selector": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "kind",
                          "selector"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "text-present"
                          },
                          "text": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "kind",
                          "text"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "required": [
                "id",
                "selector"
              ],
              "additionalProperties": false
            }
          },
          "scenarios": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "identity": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "permissions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "state": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "props": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "route": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "params": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "query": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "path"
                  ],
                  "additionalProperties": false
                },
                "locale": {
                  "type": "string"
                },
                "businessPaths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "http": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "origin": {
                        "type": "string"
                      },
                      "method": {
                        "type": "string",
                        "minLength": 1
                      },
                      "path": {
                        "type": "string"
                      },
                      "query": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      "body": {},
                      "response": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "integer",
                            "minimum": 100,
                            "maximum": 599
                          },
                          "headers": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
                              "type": "string"
                            }
                          },
                          "body": {},
                          "bodyFile": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^(?![\\\\/]|[A-Za-z]:)"
                          }
                        },
                        "required": [
                          "status"
                        ],
                        "additionalProperties": false
                      },
                      "provenance": {
                        "type": "string"
                      },
                      "envelope": {
                        "type": "boolean",
                        "const": false
                      }
                    },
                    "required": [
                      "method",
                      "path",
                      "response"
                    ],
                    "additionalProperties": false
                  }
                },
                "handlers": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?![\\\\/]|[A-Za-z]:)"
                },
                "ws": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^\\/[^?#]*$"
                      },
                      "send": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "data": {
                              "type": "string"
                            },
                            "delay": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 60000
                            }
                          },
                          "required": [
                            "data"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "replies": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "match": {
                              "type": "string"
                            },
                            "data": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "match",
                            "data"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "close": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "integer",
                            "minimum": 1000,
                            "maximum": 4999
                          },
                          "reason": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "path"
                    ],
                    "additionalProperties": false
                  }
                },
                "sse": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^\\/[^?#]*$"
                      },
                      "events": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "data": {
                              "type": "string"
                            },
                            "event": {
                              "type": "string"
                            },
                            "id": {
                              "type": "string"
                            },
                            "retry": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "delay": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 60000
                            }
                          },
                          "required": [
                            "data"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "keepOpen": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "path",
                      "events"
                    ],
                    "additionalProperties": false
                  }
                },
                "envelope": {
                  "type": "object",
                  "properties": {
                    "template": {}
                  },
                  "required": [
                    "template"
                  ],
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "root",
          "runtime"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "projects"
  ],
  "additionalProperties": false,
  "$id": "https://dsh-page-preview.local/schema/page-preview.config.schema.json",
  "title": "dsh-page-preview project config",
  "description": "由 src/shared/config/schema.ts 生成的结构校验；ID、场景引用、策略兼容及来源/路径约束另由运行时校验。插件自定协议（方案 §8），不是 DSH 官方格式。"
}
