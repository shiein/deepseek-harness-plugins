{
  "name": "@local/dsh-data-masking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mask sensitive business data (regions, departments, terms, people, addresses, ID segments) in every DSH model request, and restore it in the reply, so the provider only sees placeholders.",
  "icon": "icon.svg",
  "scripts": {
    "test": "node ../scripts/sync-shared.mjs --check && node --test test/*.test.mjs",
    "test:e2e": "node test/e2e/headless.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "host/*.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
