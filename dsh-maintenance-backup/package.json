{
  "name": "@local/dsh-maintenance-backup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 配置与插件网盘备份维护（macOS / Windows 跨平台）：连接状态、备份范围、立即备份、定时策略、快照预览与两阶段还原。",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host/*.js",
    "host/*/*.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "assets/**",
    "docs/*.md",
    "README.md",
    "AGENTS.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
